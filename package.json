{
  "name": "philipkwong-agents",
  "version": "1.0.0",
  "description": "Lead acquisition agents for Philip Kwong",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "scrape:leads": "node --env-file=.env.local --import tsx agents/lead-scraper/index.ts",
    "scrape:all": "node --env-file=.env.local --import tsx agents/scraper/orchestrator.ts",
    "scrape:gli": "node --env-file=.env.local --import tsx agents/scraper/gli.ts",
    "scrape:opportunity": "node --env-file=.env.local --import tsx agents/scraper/opportunity.ts",
    "scrape:government": "node --env-file=.env.local --import tsx agents/scraper/government.ts",
    "intake": "node --env-file=.env.local --import tsx agents/intake-agent/index.ts",
    "lead:add": "node --env-file=.env.local --import tsx agents/scraper/lead-add.ts",
    "gate:harvest": "node --env-file=.env.local --import tsx agents/scraper/gate-harvest.ts",
    "gate:measure": "node --env-file=.env.local --import tsx agents/scraper/gate-measure.ts",
    "typecheck": "tsc --noEmit",
    "gate:terms": "node --env-file=.env.local --import tsx agents/scraper/gate-term-test.ts",
    "gate:regate": "node --env-file=.env.local --import tsx agents/scraper/regate-stored.ts",
    "verify:geography": "node --import tsx agents/scraper/verify-geography.ts",
    "corpus:snapshot": "node --env-file=.env.local --import tsx agents/scraper/corpus-snapshot.ts",
    "verify:urls": "node --env-file=.env.local --import tsx agents/scraper/verify-urls.ts",
    "summaries": "node --env-file=.env.local --import tsx agents/scraper/migrations/backfill-project-summaries.ts",
    "venues:plan-names": "node --env-file=.env.local --import tsx agents/scraper/migrations/clear-plan-name-venues.ts",
    "sig:backfill": "node --env-file=.env.local --import tsx agents/scraper/migrations/backfill-significance.ts",
    "sig:calibrate": "node --env-file=.env.local --import tsx agents/scraper/significance-calibrate.ts",
    "dismiss:regate": "node --env-file=.env.local --import tsx agents/scraper/migrations/dismiss-regate-classes.ts",
    "dismiss:nyc-mixed-use": "node --env-file=.env.local --import tsx agents/scraper/migrations/dismiss-nyc-mixed-use.ts",
    "rename:instruments": "node --env-file=.env.local --import tsx agents/scraper/migrations/rename-instrument-projects.ts",
    "contacts:backfill": "node --env-file=.env.local --import tsx agents/scraper/migrations/backfill-contacts.ts",
    "owner:backfill": "node --env-file=.env.local --import tsx agents/scraper/migrations/backfill-owner.ts",
    "projects:sweep": "node --env-file=.env.local --import tsx agents/scraper/sweep-inbox.ts",
    "dismiss:unadmitted": "node --env-file=.env.local --import tsx agents/scraper/migrations/dismiss-unadmitted-projects.ts",
    "park:compliance": "node --env-file=.env.local --import tsx agents/scraper/migrations/park-compliance-and-dismiss.ts",
    "names:audit": "node --env-file=.env.local --import tsx agents/scraper/name-audit.ts",
    "rename:provisional": "node --env-file=.env.local --import tsx agents/scraper/migrations/rename-provisional-projects.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "@sentry/node": "^10.68.0",
    "@supabase/supabase-js": "^2.39.0",
    "csv-parse": "^5.5.6",
    "date-fns": "^4.4.0",
    "fastest-levenshtein": "^1.0.16",
    "googleapis": "^173.0.0",
    "pdf-parse": "^1.1.1",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
