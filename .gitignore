# dependencies
node_modules/

# secrets — never commit
.env
.env.local
.env*.local
credentials.json
token.json

# next.js
dashboard/.next/
dashboard/out/

# build output
dist/
*.tsbuildinfo

# misc
.vercel
*.log
.DS_Store

# brand fonts: commit only the flat woff2 (web) + ttf (PDF) the app references;
# ignore the vendor originals (versioned folders, otf, woff) to keep the tree lean.
dashboard/public/fonts/PP Neue York*/
dashboard/public/fonts/*.otf
dashboard/public/fonts/*.woff
scratch-leads.json

# next.js generated types: regenerated on every build, never hand-edited
dashboard/next-env.d.ts

# database backups: client research, never committed
backups/

# working scripts for a session: never part of the repo
scratch/

# frozen gate-candidate corpus (npm run gate:harvest): a re-fetchable snapshot of
# what the portals served, tens of megabytes, regenerated on demand. The LABELS
# derived from it are committed (agents/scraper/fixtures/), because those are the
# judgements the precision and recall numbers rest on.
gate-corpus/

# Playwright screenshot harness (dashboard). Proof, not source: regenerated by
# `npm run shots`. The auth state holds a live session token and must never be
# committed.
dashboard/e2e/.auth/
# The CONTENTS of shots/, not the directory itself. Git does not descend into an
# excluded directory, so a negation under `dashboard/e2e/shots/` never fires -
# the walkthrough captures below were only ever tracked because they had been
# added before that rule existed, which made the exception look like it worked.
# Excluding the children individually is what makes the two negations real.
dashboard/e2e/shots/*
# ...except the walkthrough captures, which WALKTHROUGH.md embeds. Those are
# documentation, not regression output: without them the document renders as a
# page of broken images for anyone who has not run the harness.
!dashboard/e2e/shots/walkthrough/
# ...and the generated documents. These are the product's actual output - the
# thing a client receives - and "done means generated" is only checkable if the
# artefact can be opened by someone who did not run the harness. Small (7k to
# 45k) and regenerated by e2e/report.shots.ts.
#
# EVERY FILE IN HERE HAS A GENERATOR, AND THAT IS THE ENTRY CONDITION. Five did
# not - jkr-report.pdf, jkr-report.csv, simtec-report.pdf, simtec-report.csv,
# live-clients.json - and were removed on 2026-08-25 after a grep for their
# names across every .ts, .mjs, .js, .json and .md outside node_modules
# returned nothing. They had been frozen at 2026-08-08 while the files beside
# them were current, so what a reader opened was seventeen days stale with no
# way to refresh it, which is the opposite of what this exception is for. If a
# JKR or Simtec sample is worth committing, it gets a generator in
# e2e/report.shots.ts like everything else here. Do not copy one in by hand.
!dashboard/e2e/shots/documents/
dashboard/test-results/
test-results/
dashboard/playwright-report/

# Playwright's failure artefacts. Regenerated per run; never source.
dashboard/test-results/
test-results/

# THE CEQR BYTE CACHE. Documents fetched from CEQR Access, keyed on the
# server-side path. Not versioned: it runs to hundreds of megabytes and every
# byte of it is re-fetchable. It exists because the handler serves at about
# 33 KB/s - 217 seconds for one 7.8MB draft scope against 0.2 to parse it - so a
# re-run that had to fetch again would cost the whole schedule. See migration
# 036: ceqr_documents.read_at is the durable half of the same idea.
.ceqr-cache/

# Corpus snapshots are generated artefacts, timestamped per run. The generator
# is versioned; its output is not, or every run adds a file nobody reads.
# npm run corpus:snapshot
snapshots/

# THE DARK PROJECT'S COPY OF THE GENERATED DOCUMENTS. report.shots.ts runs in
# both capture projects and every assertion in it is worth running twice, so
# both generate; only light writes the committed set in e2e/shots/documents/,
# because a PDF has no colour scheme. Dark writes here instead so the two
# projects never call saveAs on one path, which at more than one worker is a
# torn document rather than a wasted one. Nobody reads it.
dashboard/e2e/shots/documents-dark/

# GENERATED CLIENT DOCUMENTS. deliverables/<date>/ is what was sent, not how it
# is built. The builder is lib/report-build.ts and the assertions are in
# e2e/report.shots.ts; a PDF checked in beside them is an output that goes stale
# the moment the corpus moves, and the committed set the suite regenerates
# already lives in dashboard/e2e/shots/documents/.
deliverables/

# A SERPER SCAN OF A DIFFERENT VERTICAL. Auto repair in Chattanooga and Fort
# Wayne, kept as raw HTML and JSON. Not hospitality, not entertainment, and not
# source: it answers a question about whether the scan shape works, and the
# answer belongs in a note rather than in the tree.
opportunity-scan/

# Corrected reissues of the 22 misbranded deliveries. Generated by
# dashboard/scripts/reissue-misbranded.ts, regenerable from the delivery rows,
# and client documents: they are not artefacts to version.
/reissue/
