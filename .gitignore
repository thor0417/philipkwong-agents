# dependencies
node_modules/

# secrets — never commit
.env
.env.local
.env*.local
credentials.json
token.json

# next.js
dashboard/.next/
dashboard/out/

# build output
dist/
*.tsbuildinfo

# misc
.vercel
*.log
.DS_Store

# brand fonts: commit only the flat woff2 (web) + ttf (PDF) the app references;
# ignore the vendor originals (versioned folders, otf, woff) to keep the tree lean.
dashboard/public/fonts/PP Neue York*/
dashboard/public/fonts/*.otf
dashboard/public/fonts/*.woff
scratch-leads.json

# next.js generated types: regenerated on every build, never hand-edited
dashboard/next-env.d.ts

# database backups: client research, never committed
backups/

# working scripts for a session: never part of the repo
scratch/

# frozen gate-candidate corpus (npm run gate:harvest): a re-fetchable snapshot of
# what the portals served, tens of megabytes, regenerated on demand. The LABELS
# derived from it are committed (agents/scraper/fixtures/), because those are the
# judgements the precision and recall numbers rest on.
gate-corpus/

# Playwright screenshot harness (dashboard). Proof, not source: regenerated by
# `npm run shots`. The auth state holds a live session token and must never be
# committed.
dashboard/e2e/.auth/
dashboard/e2e/shots/
# ...except the walkthrough captures, which WALKTHROUGH.md embeds. Those are
# documentation, not regression output: without them the document renders as a
# page of broken images for anyone who has not run the harness.
!dashboard/e2e/shots/walkthrough/
dashboard/test-results/
dashboard/playwright-report/
