# Copy to dashboard/.env.local for local dev (gitignored).
# On Vercel, set these in Project Settings -> Environment Variables instead.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Error tracking. The dashboard reads NEXT_PUBLIC_SENTRY_DSN, and Next only
# loads .env files from THIS directory - it does not read the repo-root
# .env.local that the agents use. That gap meant the dashboard's Sentry was
# inert: instrumentation.ts no-ops without a DSN, so nothing the dashboard did
# was ever reported, while the scraper's Sentry worked fine and made it look
# like coverage existed. Set it here for local runs and in the Vercel project
# env for deployed ones. Leave unset and Sentry is a no-op, as before.
NEXT_PUBLIC_SENTRY_DSN=
