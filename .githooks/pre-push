#!/bin/sh
#
# THE OTHER HALF OF THE GATE. Everything the pre-commit hook is too slow to run.
#
# Measured on this machine:
#
#   root npm run verify        60s   (every scraper suite, incl. the live feeds)
#   dashboard build            19s
#   dashboard Playwright     13.5m   (63 tests, light + dark + walkthrough)
#   audit:exclusions           32s
#                            ------
#                            ~15.5m
#
# That is the real cost of being sure, and it is why it is on push rather than
# on commit: a push is a deliberate act a few times a day, and a commit is not.
#
# THE PLAYWRIGHT SUITE NEEDS A SERVER and this hook does not start one, because
# a hook that leaves an orphaned Next server behind on failure is worse than a
# hook that tells you to start one. If nothing is listening on :3000 it says so
# and refuses, rather than reporting 63 failures that mean "no server".
#
# Skipping is possible - git push --no-verify - and there is one legitimate
# reason: pushing a branch that is deliberately mid-work. Pushing to main with
# --no-verify is not that.
#
# AND SAYING SO IS NOT THE SAME AS REFUSING, WHICH THIS HOOK LEARNED THE HARD
# WAY. It printed "NOT RUN: the full Playwright suite. Nothing is on :3000" and
# then exited 0 over three commits that change report rendering - the exact
# thing the suite asserts. The banner was honest and the exit code was not, and
# a caller who reads the exit code, which is every caller, was told the
# dashboard had been exercised.
#
# That is the NEVER PIPE A GATE shape one level up: the thing standing in for
# the work got checked instead of the work. So the skip is now conditional on
# what is actually being pushed. A scraper or config change still goes out
# without a server, because demanding one for those is how the first version of
# this hook taught everyone to use --no-verify. A change under dashboard/ does
# not, and the refusal names the files that made it mandatory rather than
# leaving the author to guess which of their commits triggered it.

echo "--- pre-push gate ---"

fail=0

# ---- WHAT IS ACTUALLY BEING PUSHED ------------------------------------------
#
# git feeds the hook one line per ref on stdin: <local ref> <local sha>
# <remote ref> <remote sha>. A remote sha of all zeros is a branch the remote
# does not have yet, so there is nothing to diff against and the whole tree is
# treated as changed; a local sha of all zeros is a deletion and changes no
# files. Neither case may silently produce an empty file list, because an empty
# list is what says "no dashboard change here, go ahead".
Z=0000000000000000000000000000000000000000
pushed_files=""
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  [ "$local_sha" = "$Z" ] && continue
  if [ "$remote_sha" = "$Z" ]; then
    branch="${remote_ref#refs/heads/}"
    base=$(git merge-base "$local_sha" "${1:-origin}/$branch" 2>/dev/null)
  else
    base="$remote_sha"
  fi
  if [ -n "$base" ]; then
    diff_out=$(git diff --name-only "$base" "$local_sha" 2>/dev/null)
  else
    diff_out=$(git ls-tree -r --name-only "$local_sha" 2>/dev/null)
  fi
  pushed_files="$pushed_files$diff_out
"
done

dashboard_files=$(printf '%s\n' "$pushed_files" | grep '^dashboard/' | sort -u)

run() {
  label="$1"
  shift
  echo ""
  echo "> $label"
  "$@"
  rc=$?
  if [ $rc -ne 0 ]; then
    echo "  $label EXIT $rc"
    fail=1
  else
    echo "  $label ok"
  fi
}

# WHAT ALWAYS RUNS. Deterministic, code-owned, needs no server: every scraper
# suite, the golden set, and the exclusion audit.
# THE SPLIT CHECK RUNS FIRST, because it is the only one that can see a defect
# the other three cannot: a tree that builds green here and fails on Vercel. It
# costs milliseconds and it forbids the one import shape that has caused that.
run "split check" node scripts/check-split.mjs
run "root verify" npm run --silent verify
run "audit:exclusions" sh -c 'cd dashboard && npm run --silent audit:exclusions'

# WHAT RUNS WHEN IT CAN, AND SAYS SO WHEN IT CANNOT.
#
# THIS HOOK REFUSED ITS OWN AUTHOR TWICE ON ITS FIRST DAY, and both times it was
# right about the condition and wrong about the consequence. It demanded a
# running server and refused the push when there was none, so the only way to
# push anything was --no-verify - and a gate that is bypassed every time is
# worse than no gate, because it also supplies the excuse.
#
# It refuses on what it RAN and reports loudly on what it could not. That is
# standing rule 3 applied to the gate itself: nothing is silently absent. A hook
# that skips a suite in silence is the same defect as a document that withholds
# a project in silence.
if curl -s -o /dev/null -m 3 http://localhost:3000/login; then
  # E2E_SHOTS_ROOT SO THE GATE STOPS DIRTYING THE TREE IT JUST VERIFIED.
  #
  # Two directories under dashboard/e2e/shots are committed and a full run
  # rewrites 35 of the 40 files in them. Run by a person that is the point; run
  # here it means every successful push leaves a modified working copy, and the
  # next session opens on churn that looks like unfinished work. Nineteen files
  # on the run that prompted this, all of it PDF byte sizes and one count that
  # moved because the corpus advanced between the two runs.
  #
  # e2e/shots/gate/ rather than a sibling directory: .gitignore already carries
  # `dashboard/e2e/shots/*` with two negations under it, so a new child of
  # shots/ is ignored by the rule that is already there. No new entry, and no
  # third negation to get wrong.
  run "dashboard playwright" sh -c 'cd dashboard && E2E_SHOTS_ROOT=e2e/shots/gate npx playwright test'
else
  echo ""
  echo "  ####################################################################"
  echo "  #  NOT RUN: the full Playwright suite. Nothing is on :3000.        #"
  echo "  #                                                                  #"
  echo "  #  This push is going out WITHOUT the dashboard being exercised.   #"
  echo "  #  That is fine for a scraper or config change and is not fine     #"
  echo "  #  for a dashboard one. To run it:                                 #"
  echo "  #      cd dashboard && npm run build && npm run start              #"
  echo "  #  then push again. Use the production server, not npm run dev:    #"
  echo "  #  this repo sits inside OneDrive, which locks .next/types and     #"
  echo "  #  makes long dev runs fail with EBUSY in ways that read as        #"
  echo "  #  product defects.                                                #"
  echo "  ####################################################################"

  # AND IF THE PUSH TOUCHES THE DASHBOARD, THE BANNER IS NOT ENOUGH.
  if [ -n "$dashboard_files" ]; then
    n=$(printf '%s\n' "$dashboard_files" | wc -l | tr -d ' ')
    echo ""
    echo "> dashboard playwright"
    echo "  dashboard playwright EXIT 1"
    echo ""
    echo "  This push changes $n file(s) under dashboard/, so the suite is not"
    echo "  optional for it. These are the files that made it mandatory:"
    printf '%s\n' "$dashboard_files" | head -20 | sed 's/^/      /'
    if [ "$n" -gt 20 ]; then
      echo "      ... and $((n - 20)) more"
    fi
    fail=1
  fi
fi

echo ""
if [ $fail -ne 0 ]; then
  echo "PUSH REFUSED. The gate is red."
  echo ""
  echo "Six client-document tests fail whenever client_projects holds no"
  echo "confirmed row - that is the membership gate working, not a regression."
  echo "Check it before diagnosing anything else:"
  echo "    select status, count(*) from client_projects group by 1"
  exit 1
fi

echo "pre-push gate green."
exit 0
